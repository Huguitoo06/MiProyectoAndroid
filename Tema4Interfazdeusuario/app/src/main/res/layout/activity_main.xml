<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/pantalla"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <!-- TextView -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INICIAR SESIÓN"
            android:textSize="25sp"
            android:textStyle="bold" />

        <!-- Usuario -->
        <EditText
            android:id="@+id/usuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Usuario" />

        <!-- Contraseña -->
        <EditText
            android:id="@+id/contrasena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contraseña"
            android:inputType="textPassword" />

        <!-- Button -->
        <Button
            android:id="@+id/entrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Entrar" />

        <!-- ToggleButton -->
        <ToggleButton
            android:id="@+id/activar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOn="Activado"
            android:textOff="Desactivado" />

        <!-- ImageButton -->
        <ImageButton
            android:id="@+id/imagen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_camera"
            android:contentDescription="Botón con imagen" />

        <!-- AutoCompleteTextView -->
        <AutoCompleteTextView
            android:id="@+id/autocompletar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Escribe una ciudad" />

        <!-- MultiAutoCompleteTextView -->
        <MultiAutoCompleteTextView
            android:id="@+id/multiautocompletar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Escribe varias ciudades" />

        <!-- Spinner -->
        <Spinner
            android:id="@+id/selector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- CheckBox -->
        <CheckBox
            android:id="@+id/checkbox1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Opción 1" />

        <!-- RadioGroup -->
        <RadioGroup
            android:id="@+id/grupoRadios"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radio1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hombre" />

            <RadioButton
                android:id="@+id/radio2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mujer" />

            <RadioButton
                android:id="@+id/radio3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Otro" />

        </RadioGroup>

        <!-- Botón para comprobar la selección -->
        <Button
            android:id="@+id/botonComprobar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Comprobar selección" />

        <!-- Resultado de la selección -->
        <TextView
            android:id="@+id/textoResultado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selecciona una opción"
            android:textSize="18sp"
            android:padding="10dp" />

    </LinearLayout>

</ScrollView>
